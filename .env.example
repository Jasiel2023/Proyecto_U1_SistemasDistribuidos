# Plantilla de desarrollo. Nunca versionar secretos reales.
# Copiar a .env y ajustar para el entorno local.

POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia_esto
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT: debe tener al menos 32 caracteres (256 bits para HS256)
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRATION_MS=3600000

# Origen(es) del frontend separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cuenta inicial de desarrollo del microservicio de autenticacion
APP_ADMIN_ENABLED=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123

# Conexión local a RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# PostgreSQL propio de Resultados
RESULTADOS_DB_NAME=resultadosdb
RESULTADOS_DB_USER=resultados
RESULTADOS_DB_PASSWORD=resultados
RESULTADOS_DB_HOST_PORT=5436
RESULTADOS_DB_URL=jdbc:postgresql://localhost:5436/resultadosdb

# Contrato RabbitMQ compartido (nombres de develop)
RESULTADOS_EXCHANGE=votacion.exchange
RESULTADOS_ROUTING_KEY=voto.emitido
RESULTADOS_QUEUE=votos.procesados
RESULTADOS_DLQ=votos.procesados.dlq

# Gateway y URLs internas de Compose
GATEWAY_PORT=8080
FRONTEND_PORT=3000
RESULTADOS_URL=http://resultados-service:8083
RESULTADOS_WS_URL=ws://resultados-service:8083/ws

# Orígenes permitidos (separados por coma)
RESULTADOS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
RESULTADOS_WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
GATEWAY_WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend en desarrollo
VITE_GATEWAY_URL=http://localhost:8080
